# Kopiraj kao .streamlit/secrets.toml (lokalno) ili zalijepi u
# Streamlit Cloud → Settings → Secrets
#
# Supabase → Project Settings → API

# Samo Project URL — BEZ /rest/v1 (inače PGRST125)
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SERVICE_ROLE_KEY"

# Opcionalno
# TCG_API_KEY = ""
# JUSTTCG_API_KEY = ""
# SUPABASE_DB_URL = "postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# eBay Browse (Production) — obavezno na Streamlit Cloud (.env se ne deploya)
EBAY_APP_ID = "YOUR_APP_ID"
EBAY_CERT_ID = "YOUR_CERT_ID"
EBAY_DEV_ID = "YOUR_DEV_ID"
# EBAY_OAUTH_TOKEN = ""
# EBAY_MARKETPLACE_ID = "EBAY_US"

# Alternativa nested:
# [ebay]
# app_id = "YOUR_APP_ID"
# cert_id = "YOUR_CERT_ID"
# dev_id = "YOUR_DEV_ID"
# oauth_token = ""

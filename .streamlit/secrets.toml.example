# =============================================================================
# Streamlit Cloud deploy checklist
# =============================================================================
# 1) App → Settings → Secrets: paste this TOML (real values), Save, Reboot
# 2) Repo root must have requirements.txt + packages.txt (libgomp1 for XGBoost)
# 3) Supabase SQL (once): supabase_schema.sql / supabase_rls_harden.sql,
#    supabase_auth_sessions.sql, supabase_model_artifacts.sql,
#    supabase_market_quotes.sql
# 4) Never set AUTH_DISABLED on Cloud
# 5) Keys: Supabase → Project Settings → API
#      SUPABASE_URL      = Project URL (https://xxxx.supabase.co, NO /rest/v1)
#      SUPABASE_KEY      = service_role (catalog / nightly / auth_sessions write)
#      SUPABASE_ANON_KEY = anon public (login + portfolio/watchlist JWT)
# =============================================================================

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY = "YOUR_ANON_PUBLIC_KEY"

# Local only — Cloud ignores AUTH_DISABLED via _is_streamlit_cloud()
# AUTH_DISABLED = "1"

# Optional data providers
# TCG_API_KEY = ""
# JUSTTCG_API_KEY = ""
# SUPABASE_DB_URL = "postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# eBay Browse (Production) — required on Cloud (.env is not deployed)
EBAY_APP_ID = "YOUR_APP_ID"
EBAY_CERT_ID = "YOUR_CERT_ID"
EBAY_DEV_ID = "YOUR_DEV_ID"
# EBAY_OAUTH_TOKEN = ""
# EBAY_MARKETPLACE_ID = "EBAY_US"

# Nested alternative:
# [ebay]
# app_id = "YOUR_APP_ID"
# cert_id = "YOUR_CERT_ID"
# dev_id = "YOUR_DEV_ID"
# oauth_token = ""

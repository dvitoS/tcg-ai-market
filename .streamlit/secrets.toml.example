# =============================================================================
# Streamlit Cloud deploy checklist
# =============================================================================
# 1) App settings → Advanced → Python version = 3.12 (not 3.13/3.14 defaults)
# 2) App → Settings → Secrets: paste this TOML (real values), Save, Reboot
# 3) Repo root: requirements.txt + packages.txt (libgomp1 for XGBoost)
# 4) Supabase SQL (once): supabase_schema.sql / supabase_rls_harden.sql,
#    supabase_auth_sessions.sql, supabase_model_artifacts.sql,
#    supabase_market_quotes.sql
# 5) Never set AUTH_DISABLED on Cloud
# 6) Keys: Supabase → Project Settings → API
#      SUPABASE_URL      = Project URL (https://xxxx.supabase.co, NO /rest/v1)
#      SUPABASE_KEY      = service_role (catalog / nightly / auth_sessions write)
#      SUPABASE_ANON_KEY = anon public (login + portfolio/watchlist JWT)
# =============================================================================

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY = "YOUR_ANON_PUBLIC_KEY"

# Local only — Cloud ignores AUTH_DISABLED via _is_streamlit_cloud()
# AUTH_DISABLED = "1"

# Optional data providers
# TCG_API_KEY = ""
# JUSTTCG_API_KEY = ""
# SUPABASE_DB_URL = "postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# eBay Browse (Production) — required on Cloud (.env is not deployed)
EBAY_APP_ID = "YOUR_APP_ID"
EBAY_CERT_ID = "YOUR_CERT_ID"
EBAY_DEV_ID = "YOUR_DEV_ID"
# EBAY_OAUTH_TOKEN = ""
# EBAY_MARKETPLACE_ID = "EBAY_US"

# Nested alternative:
# [ebay]
# app_id = "YOUR_APP_ID"
# cert_id = "YOUR_CERT_ID"
# dev_id = "YOUR_DEV_ID"
# oauth_token = ""

# Optional: expand / override curated catalog (id:Name, comma-separated)
# CATALOG_SET_IDS = "sv3pt5:151,sv8:Surging Sparks,swsh7:Evolving Skies"

# Optional: nightly watchlist email digests (also set these in GitHub Actions secrets)
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = "587"
# SMTP_USER = "apikey_or_user"
# SMTP_PASSWORD = "secret"
# SMTP_FROM = "alerts@example.com"
# ALERT_EMAIL_TO = "you@example.com"   # fallback if auth admin email lookup fails
# ALERT_THRESHOLD_PCT = "5"
# ALERT_SURE_ONLY = "1"   # nightly emails: conformal BUY/SELL only (set "0" for legacy)
# DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/..."  # sure-only channel digest

# EBAY_LIQUIDITY_SAMPLE_N = "40"  # nightly Browse depth sample for model features

# Soft Pro gate (before Stripe). Default open beta.
# PRO_OPEN = "1"
# PRO_OPEN = "0"
# PRO_EMAILS = "you@example.com,partner@shop.com"
# PRO_USER_IDS = "uuid-1,uuid-2"

# Local Next.js → FastAPI
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (Vercel): https://api.YOURDOMAIN.com  — see docs/DEPLOY.md
# NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com

# Google sign-in (optional). Same project URL + anon key as the API.
# Enable Google under Supabase → Authentication → Providers, then set both:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Search Console HTML-tag verification token (content=… value only).
# Set on Vercel after adding the property for www.kestreltcg.app.
# GOOGLE_SITE_VERIFICATION=

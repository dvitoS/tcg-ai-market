{
  "name": "Kestrel Soft Ink",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "docs/DEPLOY.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y libgomp1 && pip3 install --user -r requirements.txt -r requirements-api.txt -r requirements-dev.txt && (cd web && npm install)",
  "postAttachCommand": {
    "api": "PYTHONPATH=. uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
    "web": "cd web && npm run dev -- --hostname 0.0.0.0 --port 3000"
  },
  "portsAttributes": {
    "3000": {
      "label": "Soft Ink",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "API",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [3000, 8000]
}

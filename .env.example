# Local setup: copy to .env and fill values.
# Cloud: use .streamlit/secrets.toml / Streamlit Secrets (see secrets.toml.example).
# Install: pip install -r requirements.txt
# API (Next.js): pip install -r requirements-api.txt
# Dev tests: pip install -r requirements-dev.txt && pytest -q

# FastAPI CORS (comma-separated). Local + production Soft Ink web origins.
# KESTREL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.YOURDOMAIN.com
# Production: AUTH_DISABLED=0  ·  see docs/DEPLOY.md
# Soft Ink public URL — Streamlit shows a migration banner when set:
# SOFT_INK_URL=https://app.YOURDOMAIN.com
# KESTREL_WEB_URL=https://app.YOURDOMAIN.com

JUSTTCG_API_KEY=
TCG_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role — nightly/backfill/catalog sync ONLY (bypasses RLS)
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
# anon public — Streamlit Auth + portfolio/watchlist (RLS: auth.uid())
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# Local only — skip login gate (ignored on Streamlit Cloud)
AUTH_DISABLED=1
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
# DEV_USER_EMAIL=dev@local
# Opcionalno — automatski CREATE TABLE (Settings → Database → URI)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# eBay Marketplace Account Deletion webhook (ebay_webhook.py)
# Endpoint u eBay Notifications mora biti TOČNO isti kao EBAY_DELETION_ENDPOINT
EBAY_DELETION_ENDPOINT=https://YOUR_HOST/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=change_me_to_32_80_chars_letters_numbers_underscore
# Browse API (aktivni oglasi) — Production keyset + opcioni user/app token:
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_OAUTH_TOKEN=
# EBAY_MARKETPLACE_ID=EBAY_US

# Optional catalog override (id:Name,...). Empty = built-in curated list.
# CATALOG_SET_IDS=sv3pt5:151,sv8:Surging Sparks,swsh7:Evolving Skies

# Optional nightly watchlist email digests
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# ALERT_EMAIL_TO=you@example.com
# ALERT_THRESHOLD_PCT=5
# ALERT_SURE_ONLY=1
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Nightly eBay liquidity sample size (Browse active depth → model features)
# EBAY_LIQUIDITY_SAMPLE_N=40
# eBay Partner Network (click-out attribution)
# EPN_CAMPID=5338xxxxxx
# EPN_MKRID=711-53200-19255-0
# EPN_TOOLID=10001
# EPN_CUSTOMID=tcg-ai
# Soft Pro (open beta default). Lock with PRO_OPEN=0 after Creem is live.
# PRO_OPEN=1
# PRO_EMAILS=you@example.com
# PRO_USER_IDS=
# Creem product Share → payment link (Upgrade CTA on locked Dealer).
# PRO_CHECKOUT_URL=https://www.creem.io/payment/prod_xxxxx
# Set product success URL to https://www.kestreltcg.app/pro/success
# CREEM_WEBHOOK_SECRET=whsec_...   # Developers → Webhooks → signing secret
# Webhook URL: https://api.kestreltcg.app/api/webhooks/creem
# Events: checkout.completed, subscription.active, subscription.paid,
#         subscription.canceled, subscription.expired, subscription.past_due

# Local setup: copy to .env and fill values.
# Cloud: use .streamlit/secrets.toml / Streamlit Secrets (see secrets.toml.example).
# Install: pip install -r requirements.txt
# Dev tests: pip install -r requirements-dev.txt && pytest -q

JUSTTCG_API_KEY=
TCG_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role — nightly/backfill/catalog sync ONLY (bypasses RLS)
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
# anon public — Streamlit Auth + portfolio/watchlist (RLS: auth.uid())
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# Local only — skip login gate (ignored on Streamlit Cloud)
AUTH_DISABLED=1
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
# DEV_USER_EMAIL=dev@local
# Opcionalno — automatski CREATE TABLE (Settings → Database → URI)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# eBay Marketplace Account Deletion webhook (ebay_webhook.py)
# Endpoint u eBay Notifications mora biti TOČNO isti kao EBAY_DELETION_ENDPOINT
EBAY_DELETION_ENDPOINT=https://YOUR_HOST/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=change_me_to_32_80_chars_letters_numbers_underscore
# Browse API (aktivni oglasi) — Production keyset + opcioni user/app token:
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_OAUTH_TOKEN=
# EBAY_MARKETPLACE_ID=EBAY_US

# Optional catalog override (id:Name,...). Empty = built-in curated list.
# CATALOG_SET_IDS=sv3pt5:151,sv8:Surging Sparks,swsh7:Evolving Skies

# Optional nightly watchlist email digests
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# ALERT_EMAIL_TO=you@example.com
# ALERT_THRESHOLD_PCT=5
# ALERT_SURE_ONLY=1
